# Copie para ".env" e preencha conforme necessário.
# NUNCA coloque segredos neste arquivo — ele é público de exemplo.

# URL pública canônica do site (canonical, sitemap, robots.txt).
PUBLIC_SITE_URL=

# URL do formulário externo de cadastro (habilita o botão "Cadastrar serviço").
PUBLIC_GOOGLE_FORM_CADASTRO_URL=

# Formulários opcionais e contato institucional.
PUBLIC_GOOGLE_FORM_ALTERACAO_URL=
PUBLIC_GOOGLE_FORM_DENUNCIA_URL=
PUBLIC_CONTATO_EMAIL=
