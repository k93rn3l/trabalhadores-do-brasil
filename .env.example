# =====================================================================
# Copie para ".env" e preencha conforme necessário.
# NUNCA coloque segredos aqui — este arquivo é público de exemplo.
# =====================================================================

# URL pública canônica do site (canonical, sitemap.xml, robots.txt).
# Ex.: https://www.meudominio.com.br — vazio no Cloudflare Pages usa a *.pages.dev.
PUBLIC_SITE_URL=

# Formulário real de cadastro (público).
PUBLIC_GOOGLE_FORM_CADASTRO_URL=https://forms.gle/uKqyYZkaTpGTpepb7

# Formulários opcionais (alteração/exclusão e denúncia).
PUBLIC_GOOGLE_FORM_ALTERACAO_URL=
PUBLIC_GOOGLE_FORM_DENUNCIA_URL=

# E-mail institucional de contato.
PUBLIC_CONTATO_EMAIL=

# ---------------------------------------------------------------------
# Sincronizador (uso LOCAL; no GitHub Actions ficam em Secrets/Variables)
# ---------------------------------------------------------------------
# Planilha administrativa real (privada — o ID sozinho não dá acesso).
GOOGLE_SHEET_ID=1nxcIvRTlAf1HTXbNaeq6oo3gOJN8L52hbcL6NGzTk3M
GOOGLE_SHEET_TAB_NAME=Respostas ao formulário 1

# Segredo do HMAC que gera os IDs públicos estáveis.
# Gere com:  openssl rand -hex 32   (gude SEMPRE o mesmo valor!)
# No GitHub: Settings > Secrets and variables > Actions > Secrets.
PUBLIC_ID_SECRET=

# JSON da conta de serviço NÃO fica aqui no .env.example.
# Localmente, use:  --credenciais-arquivo caminho/da/chave.json
# No GitHub Actions: secret GOOGLE_SERVICE_ACCOUNT_JSON.

# ---------------------------------------------------------------------
# GitHub Actions — o que configurar no repositório:
#   Secrets:
#     GOOGLE_SERVICE_ACCOUNT_JSON  — JSON completo da conta de serviço
#     PUBLIC_ID_SECRET             — openssl rand -hex 32
#     CLOUDFLARE_DEPLOY_HOOK_URL   — (opcional) Deploy Hook do Pages
#     GOOGLE_SHEET_ID              — (opcional, já tem padrão no workflow)
#   Variables:
#     GOOGLE_SHEET_TAB_NAME        — (opcional) padrão: Respostas ao formulário 1
#     HABILITAR_PUBLICACAO         — "SIM" habilita a gravação do catálogo;
#                                    qualquer outro valor = apenas simulação
# ---------------------------------------------------------------------
