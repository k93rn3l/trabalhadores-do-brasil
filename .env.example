# =====================================================================
# Copie este arquivo para ".env" e preencha conforme necessário.
# NUNCA coloque segredos aqui — este arquivo é apenas um exemplo público.
# =====================================================================

# URL pública canônica do site (usada em canonical, sitemap.xml e robots.txt).
# Ex.: https://www.meudominio.com.br
# Se vazio no Cloudflare Pages, a URL gratuita *.pages.dev do build é usada.
PUBLIC_SITE_URL=

# URL do Google Forms de cadastro de profissionais.
# Enquanto vazia, o site exibe um aviso em vez de um botão quebrado.
PUBLIC_GOOGLE_FORM_CADASTRO_URL=

# URL do Google Forms de solicitação de alteração/exclusão de cadastro (opcional).
PUBLIC_GOOGLE_FORM_ALTERACAO_URL=

# URL do Google Forms de denúncia de cadastro (opcional).
PUBLIC_GOOGLE_FORM_DENUNCIA_URL=

# E-mail institucional de contato exibido no rodapé e nas páginas de suporte.
PUBLIC_CONTATO_EMAIL=

# ---------------------------------------------------------------------
# Segredos usados APENAS no GitHub Actions (Settings > Secrets > Actions):
#   GOOGLE_SHEET_ID            — ID da planilha privada
#   GOOGLE_SERVICE_ACCOUNT_JSON— JSON completo da conta de serviço
#   GOOGLE_SHEET_TAB_NAME      — nome da aba (pode ser uma variável comum)
# Nenhum deles deve aparecer no repositório ou no código do frontend.
# ---------------------------------------------------------------------
